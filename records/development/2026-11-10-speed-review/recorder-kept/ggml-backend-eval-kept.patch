+// a kept callback reads a copy of its output; a write into it would change nothing the graph computes
+static void ggml_backend_sched_eval_kept_set(ggml_backend_buffer_t, struct ggml_tensor * tensor, const void *, size_t, size_t) {
+    GGML_ABORT("GGML_SCHED_EVAL_KEPT: the eval callback wrote into %s; a kept callback holds a copy, not the tensor", tensor->name);
+}
+
+static void ggml_backend_sched_eval_kept_memset(ggml_backend_buffer_t, struct ggml_tensor * tensor, uint8_t, size_t, size_t) {
+    GGML_ABORT("GGML_SCHED_EVAL_KEPT: the eval callback wrote into %s; a kept callback holds a copy, not the tensor", tensor->name);
+}
+
+static void ggml_backend_sched_eval_kept_set_2d(ggml_backend_buffer_t, struct ggml_tensor * tensor, const void *, size_t, size_t, size_t, size_t, size_t) {
+    GGML_ABORT("GGML_SCHED_EVAL_KEPT: the eval callback wrote into %s; a kept callback holds a copy, not the tensor", tensor->name);
+}
+
+// true when computing t writes into the memory of the tensor it is a view of
+static bool ggml_backend_sched_eval_writes_in_place(const struct ggml_tensor * t) {
+    switch (t->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return false;
+        default:
+            return t->view_src != NULL;
+    }
+}
