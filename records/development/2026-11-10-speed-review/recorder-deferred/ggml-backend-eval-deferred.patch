+// host memory for one output of the split being computed: chunks are filled in order and none is freed or moved while a copy
+// into it may be waiting on the backend
+static void * ggml_backend_sched_eval_stage(ggml_backend_sched_t sched, ggml_backend_t backend, size_t size, int * chunk, size_t * used) {
+    const size_t aligned = (size + 63) & ~(size_t) 63;
+    if (sched->eval_chunks[*chunk] != NULL && *used + aligned <= ggml_backend_buffer_get_size(sched->eval_chunks[*chunk])) {
+        void * at = (char *) ggml_backend_buffer_get_base(sched->eval_chunks[*chunk]) + *used;
+        *used += aligned;
+        return at;
+    }
+    if (sched->eval_chunks[*chunk] != NULL) {
+        ++*chunk;   // the chunk in use keeps its copies; the next one is not in use by this split
+    }
+    GGML_ASSERT(*chunk < GGML_SCHED_EVAL_CHUNKS && "GGML_SCHED_EVAL_DEFERRED: more staged outputs than the chunks hold");
+    if (sched->eval_chunks[*chunk] != NULL && ggml_backend_buffer_get_size(sched->eval_chunks[*chunk]) < aligned) {
+        ggml_backend_buffer_free(sched->eval_chunks[*chunk]);
+        sched->eval_chunks[*chunk] = NULL;
+    }
+    if (sched->eval_chunks[*chunk] == NULL) {
+        ggml_backend_dev_t device = ggml_backend_get_device(backend);
+        ggml_backend_buffer_type_t buft = device ? ggml_backend_dev_host_buffer_type(device) : NULL;
+        if (buft == NULL) {
+            buft = ggml_backend_cpu_buffer_type();
+        }
+        sched->eval_chunks[*chunk] = ggml_backend_buft_alloc_buffer(buft, std::max(aligned, GGML_SCHED_EVAL_CHUNK_BYTES));
+        GGML_ASSERT(sched->eval_chunks[*chunk] != NULL && "GGML_SCHED_EVAL_DEFERRED: no host memory for the staged outputs");
+    }
+    *used = aligned;
+    return ggml_backend_buffer_get_base(sched->eval_chunks[*chunk]);
+}
